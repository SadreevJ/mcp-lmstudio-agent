{
  "mcpServers": {
    "project-filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "./workspace"
      ],
      "cwd": "."
    },
    "project-shell": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-shell@0.1.3"
      ],
      "cwd": "./workspace"
    }
  }
}
